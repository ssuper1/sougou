<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same name as the light theme, so the system picks the dark parent when in night mode. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_deep</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/header_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
